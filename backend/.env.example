PORT=3000
NODE_ENV=development
APP_NAME="SSR Solar Power Backend"
CORS_ORIGIN="http://localhost:8080"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ssr_solar_db?schema=public"
JWT_SECRET=REPLACE_WITH_64_BYTE_RANDOM_SECRET
JWT_EXPIRES_IN="1d"
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Admin Email Notification (EmailJS REST API)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_optional_emailjs_private_key
ADMIN_NOTIFICATION_EMAIL=info@ssrsolarpower.com
